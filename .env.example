# Resend (https://resend.com) - used by src/app/api/contact and src/app/api/subscribe
# Use a SENDING-ONLY key (Resend > API Keys > permission "Sending access").
# Never put a full-access key here, and never paste keys into chat.
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_EMAIL=hihopifythemecustomization@gmail.com

# Leave empty until a sending domain is verified in Resend. While empty, mail
# goes from Resend's test sender, which can only reach the Resend account's
# own email: contact-form notifications work, customer auto-replies are off.
# After verifying e.g. mail.shopifythemecustomizationservices.com:
# RESEND_FROM="Shopify Theme Customization <hello@mail.shopifythemecustomizationservices.com>"
RESEND_FROM=

# Newsletter sign-ups are saved to this Resend audience (Resend > Audiences).
RESEND_AUDIENCE_ID=

# Supabase (admin panel + database). Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only (contact form, newsletter, cron, client portal).
# Never expose it in the browser or paste it anywhere public.
SUPABASE_SECRET_KEY=

# Telegram alerts for new leads and follow-up reminders.
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/cron/follow-up. Any long random string; Vercel Cron sends it
# automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
